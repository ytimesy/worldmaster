<div id="<%= dom_id scheduled_post %>">
  <p>
    <strong>User:</strong>
    <%= scheduled_post.user_id %>
  </p>

  <p>
    <strong>Post:</strong>
    <%= scheduled_post.post_id %>
  </p>

  <p>
    <strong>Posting queue:</strong>
    <%= scheduled_post.posting_queue_id %>
  </p>

  <p>
    <strong>Scheduled at:</strong>
    <%= scheduled_post.scheduled_at %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= scheduled_post.status %>
  </p>

  <p>
    <strong>Error message:</strong>
    <%= scheduled_post.error_message %>
  </p>

</div>
