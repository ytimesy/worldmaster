<%= form_with(model: scheduled_post) do |form| %>
  <% if scheduled_post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(scheduled_post.errors.count, "error") %> prohibited this scheduled_post from being saved:</h2>

      <ul>
        <% scheduled_post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :post_id, style: "display: block" %>
    <%= form.text_field :post_id %>
  </div>

  <div>
    <%= form.label :posting_queue_id, style: "display: block" %>
    <%= form.text_field :posting_queue_id %>
  </div>

  <div>
    <%= form.label :scheduled_at, style: "display: block" %>
    <%= form.datetime_field :scheduled_at %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.label :error_message, style: "display: block" %>
    <%= form.text_area :error_message %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
