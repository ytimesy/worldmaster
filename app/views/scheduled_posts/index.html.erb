<p style="color: green"><%= notice %></p>

<% content_for :title, "Scheduled posts" %>

<h1>Scheduled posts</h1>

<div id="scheduled_posts">
  <% @scheduled_posts.each do |scheduled_post| %>
    <%= render scheduled_post %>
    <p>
      <%= link_to "Show this scheduled post", scheduled_post %>
    </p>
  <% end %>
</div>

<%= link_to "New scheduled post", new_scheduled_post_path %>
