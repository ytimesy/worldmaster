<%= form_with(model: user, class: "form-card") do |form| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <h2>入力内容を確認してください</h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :display_name, "表示名" %>
    <%= form.text_field :display_name, required: true %>
  </div>

  <div class="form-group">
    <%= form.label :username, "ユーザーID" %>
    <%= form.text_field :username, required: true %>
  </div>

  <div class="form-group">
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, required: true %>
  </div>

  <div class="form-group">
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, autocomplete: "new-password", required: user.new_record? %>
  </div>

  <div class="form-group">
    <%= form.label :password_confirmation, "パスワード確認" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", required: user.new_record? %>
  </div>

  <div class="form-group">
    <%= form.label :bio, "自己紹介" %>
    <%= form.text_area :bio %>
  </div>

  <div class="form-group">
    <%= form.label :website_url, "Webサイト" %>
    <%= form.url_field :website_url %>
  </div>

  <div class="form-group">
    <%= form.label :avatar_url, "アバターURL" %>
    <%= form.url_field :avatar_url %>
  </div>

  <% if current_user&.role == "admin" %>
    <div class="form-group">
      <%= form.label :role, "ロール" %>
      <%= form.select :role, User::ROLES %>
    </div>
  <% end %>

  <div class="form-actions">
    <%= form.submit user.new_record? ? "登録する" : "更新する", class: "button primary" %>
  </div>
<% end %>
