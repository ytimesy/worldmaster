<div id="<%= dom_id policy_proposal %>">
  <p>
    <strong>Owner:</strong>
    <%= policy_proposal.owner_id %>
  </p>

  <p>
    <strong>Related project:</strong>
    <%= policy_proposal.related_project_id %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= policy_proposal.title %>
  </p>

  <p>
    <strong>Slug:</strong>
    <%= policy_proposal.slug %>
  </p>

  <p>
    <strong>Summary:</strong>
    <%= policy_proposal.summary %>
  </p>

  <p>
    <strong>Background:</strong>
    <%= policy_proposal.background %>
  </p>

  <p>
    <strong>Problem:</strong>
    <%= policy_proposal.problem %>
  </p>

  <p>
    <strong>Proposal:</strong>
    <%= policy_proposal.proposal %>
  </p>

  <p>
    <strong>Target users:</strong>
    <%= policy_proposal.target_users %>
  </p>

  <p>
    <strong>System outline:</strong>
    <%= policy_proposal.system_outline %>
  </p>

  <p>
    <strong>Expected effect:</strong>
    <%= policy_proposal.expected_effect %>
  </p>

  <p>
    <strong>Risks:</strong>
    <%= policy_proposal.risks %>
  </p>

  <p>
    <strong>Pilot plan:</strong>
    <%= policy_proposal.pilot_plan %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= policy_proposal.status %>
  </p>

  <p>
    <strong>Visibility:</strong>
    <%= policy_proposal.visibility %>
  </p>

</div>
