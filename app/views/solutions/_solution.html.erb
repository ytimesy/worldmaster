<div id="<%= dom_id solution %>">
  <p>
    <strong>Title:</strong>
    <%= solution.title %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= solution.category %>
  </p>

  <p>
    <strong>Summary:</strong>
    <%= solution.summary %>
  </p>

  <p>
    <strong>Evidence:</strong>
    <%= solution.evidence %>
  </p>

  <p>
    <strong>Impact:</strong>
    <%= solution.impact %>
  </p>

  <p>
    <strong>Url:</strong>
    <%= solution.url %>
  </p>

  <p>
    <strong>Published:</strong>
    <%= solution.published %>
  </p>

</div>
