<div id="<%= dom_id posting_queue %>">
  <p>
    <strong>User:</strong>
    <%= posting_queue.user_id %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= posting_queue.title %>
  </p>

  <p>
    <strong>Interval minutes:</strong>
    <%= posting_queue.interval_minutes %>
  </p>

  <p>
    <strong>Start at:</strong>
    <%= posting_queue.start_at %>
  </p>

  <p>
    <strong>Next run at:</strong>
    <%= posting_queue.next_run_at %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= posting_queue.status %>
  </p>

</div>
