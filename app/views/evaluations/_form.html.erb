<%= form_with(model: evaluation) do |form| %>
  <% if evaluation.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(evaluation.errors.count, "error") %> prohibited this evaluation from being saved:</h2>

      <ul>
        <% evaluation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :solution_id, style: "display: block" %>
    <%= form.text_field :solution_id %>
  </div>

  <div>
    <%= form.label :result, style: "display: block" %>
    <%= form.text_area :result %>
  </div>

  <div>
    <%= form.label :rating, style: "display: block" %>
    <%= form.number_field :rating %>
  </div>

  <div>
    <%= form.label :published_at, style: "display: block" %>
    <%= form.date_field :published_at %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
