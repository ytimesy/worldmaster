<div id="<%= dom_id evaluation %>">
  <p>
    <strong>Solution:</strong>
    <%= evaluation.solution_id %>
  </p>

  <p>
    <strong>Result:</strong>
    <%= evaluation.result %>
  </p>

  <p>
    <strong>Rating:</strong>
    <%= evaluation.rating %>
  </p>

  <p>
    <strong>Published at:</strong>
    <%= evaluation.published_at %>
  </p>

</div>
