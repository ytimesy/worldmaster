<div id="<%= dom_id post %>">
  <p>
    <strong>User:</strong>
    <%= post.user_id %>
  </p>

  <p>
    <strong>Project:</strong>
    <%= post.project_id %>
  </p>

  <p>
    <strong>Policy proposal:</strong>
    <%= post.policy_proposal_id %>
  </p>

  <p>
    <strong>Parent post:</strong>
    <%= post.parent_post_id %>
  </p>

  <p>
    <strong>Post type:</strong>
    <%= post.post_type %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= post.body %>
  </p>

  <p>
    <strong>Visibility:</strong>
    <%= post.visibility %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= post.status %>
  </p>

  <p>
    <strong>Published at:</strong>
    <%= post.published_at %>
  </p>

  <p>
    <strong>Scheduled at:</strong>
    <%= post.scheduled_at %>
  </p>

</div>
