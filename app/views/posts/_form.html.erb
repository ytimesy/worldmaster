<%= form_with(model: post, class: "form-card") do |form| %>
  <% if post.errors.any? %>
    <div class="form-errors">
      <h2>入力内容を確認してください</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>

  <div class="form-group">
    <%= form.label :body, "本文" %>
    <%= form.text_area :body, rows: 10, required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :post_type, "投稿タイプ" %>
      <%= form.select :post_type, Post::POST_TYPES.map { |type| [type.humanize, type] } %>
    </div>

    <div class="form-group">
      <%= form.label :visibility, "公開範囲" %>
      <%= form.select :visibility, Post::VISIBILITY_STATES.map { |state| [state.humanize, state] } %>
    </div>

    <div class="form-group">
      <%= form.label :status, "ステータス" %>
      <%= form.select :status, Post::STATUS_STATES.map { |state| [state.humanize, state] } %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :project_id, "プロジェクト" %>
      <%= form.collection_select :project_id, Project.order(:title), :id, :title, { include_blank: "紐づけなし" } %>
    </div>

    <div class="form-group">
      <%= form.label :policy_proposal_id, "政策提案" %>
      <%= form.collection_select :policy_proposal_id, PolicyProposal.order(:title), :id, :title, { include_blank: "紐づけなし" } %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= form.label :parent_post_id, "親投稿" %>
      <%= form.collection_select :parent_post_id, Post.where(user: current_user).order(created_at: :desc), :id, :title, { include_blank: "なし" } %>
    </div>

    <div class="form-group">
      <%= form.label :scheduled_at, "予約日時" %>
      <%= form.datetime_field :scheduled_at %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit post.new_record? ? "投稿する" : "更新する", class: "button primary" %>
  </div>
<% end %>
