<div id="<%= dom_id project %>">
  <p>
    <strong>Owner:</strong>
    <%= project.owner_id %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= project.title %>
  </p>

  <p>
    <strong>Slug:</strong>
    <%= project.slug %>
  </p>

  <p>
    <strong>Summary:</strong>
    <%= project.summary %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= project.description %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= project.status %>
  </p>

  <p>
    <strong>Visibility:</strong>
    <%= project.visibility %>
  </p>

  <p>
    <strong>Demo url:</strong>
    <%= project.demo_url %>
  </p>

  <p>
    <strong>Github url:</strong>
    <%= project.github_url %>
  </p>

  <p>
    <strong>Cover image url:</strong>
    <%= project.cover_image_url %>
  </p>

</div>
