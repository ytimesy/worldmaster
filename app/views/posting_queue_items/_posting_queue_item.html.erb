<div id="<%= dom_id posting_queue_item %>">
  <p>
    <strong>Posting queue:</strong>
    <%= posting_queue_item.posting_queue_id %>
  </p>

  <p>
    <strong>Post:</strong>
    <%= posting_queue_item.post_id %>
  </p>

  <p>
    <strong>Position:</strong>
    <%= posting_queue_item.position %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= posting_queue_item.status %>
  </p>

  <p>
    <strong>Scheduled at:</strong>
    <%= posting_queue_item.scheduled_at %>
  </p>

  <p>
    <strong>Published at:</strong>
    <%= posting_queue_item.published_at %>
  </p>

</div>
