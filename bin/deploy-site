#!/bin/bash

# AgoraFlow / WorldMaster deployment script for Render
# This script runs tests, lints code, commits changes, and pushes to GitHub
# Render will automatically deploy from GitHub

set -e

echo "🚀 Starting AgoraFlow deployment process..."

# Check if we're in the project directory
if [ ! -f "Gemfile" ]; then
  echo "Error: Not in Rails project directory"
  exit 1
fi

# Run tests
echo "🧪 Running tests..."
bundle exec rails test

# Run linting (if rubocop is available)
if command -v rubocop &> /dev/null; then
    echo "🔍 Running RuboCop..."
    bundle exec rubocop --parallel
else
    echo "⚠️  RuboCop not found, skipping linting"
fi

# Build assets for production (optional, Render will do this)
echo "📦 Precompiling assets..."
RAILS_ENV=production bundle exec rails assets:precompile

# Add all changes
echo "📝 Adding changes to git..."
git add .

# Commit changes
echo "💾 Committing changes..."
git commit -m "Deploy AgoraFlow to Render

- Run tests and linting
- Update configuration for Render deployment
- Prepare for production deployment" || echo "No changes to commit"

# Push to GitHub (triggers Render deployment)
echo "⬆️  Pushing to GitHub..."
git push origin main

echo "✅ Deployment preparation complete!"
echo ""
echo "🌐 To complete deployment on Render:"
echo "1. Go to https://render.com"
echo "2. Create PostgreSQL database (name: worldmaster-db)"
echo "3. Create Web Service connected to GitHub repo: ytimesy/worldmaster"
echo "4. Set environment variables:"
echo "   - RAILS_ENV: production"
echo "   - RAILS_MASTER_KEY: (copy from config/master.key)"
echo "   - DATABASE_URL: (auto-populated from PostgreSQL service)"
echo "   - SECRET_KEY_BASE: (generate with: bundle exec rails secret)"
echo "5. Deploy the service"
echo "6. For custom domain ops.com:"
echo "   - In web service Settings → Custom Domains"
echo "   - Add domain: ops.com"
echo "   - Update DNS records as instructed"
echo ""
echo "📱 Default URL: https://worldmaster.onrender.com"
echo "🏠 Custom domain: https://ops.com"