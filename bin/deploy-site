#!/bin/bash

# Deploy script for AgoraFlow / WorldMaster
# This script handles deployment to Google Cloud Platform

set -e

echo "Starting deployment process..."

# Check if we're in the project directory
if [ ! -f "Gemfile" ]; then
  echo "Error: Not in Rails project directory"
  exit 1
fi

# Run tests
echo "Running tests..."
bundle exec rails test

# Run linting
echo "Running linting..."
bundle exec rubocop --parallel

# Build assets for production
echo "Precompiling assets..."
RAILS_ENV=production bundle exec rails assets:precompile

# Commit changes
echo "Committing changes..."
git add .
git commit -m "Deploy: $(date)" || echo "No changes to commit"

# Push to GitHub
echo "Pushing to GitHub..."
git push origin main

# Deploy to Cloud Run (if GCP credentials are available)
if [ -n "$GCP_PROJECT_ID" ] && [ -n "$GCP_SA_KEY" ]; then
  echo "Deploying to Google Cloud Run..."

  # Authenticate with GCP
  echo "$GCP_SA_KEY" | base64 -d > /tmp/gcp-key.json
  gcloud auth activate-service-account --key-file=/tmp/gcp-key.json
  gcloud config set project $GCP_PROJECT_ID

  # Build and deploy
  gcloud run deploy worldmaster \
    --source . \
    --platform managed \
    --region asia-northeast1 \
    --allow-unauthenticated \
    --set-env-vars RAILS_ENV=production \
    --set-env-vars RAILS_MASTER_KEY=$RAILS_MASTER_KEY \
    --set-env-vars DATABASE_URL=$DATABASE_URL \
    --set-env-vars GCP_PROJECT_ID=$GCP_PROJECT_ID \
    --port 3000

  # Get deployment URL
  DEPLOY_URL=$(gcloud run services describe worldmaster --region asia-northeast1 --format 'value(status.url)')
  echo "Deployed to: $DEPLOY_URL"

  # Map custom domain if configured
  if [ -n "$CUSTOM_DOMAIN" ]; then
    echo "Mapping custom domain: $CUSTOM_DOMAIN"
    gcloud run domain-mappings create \
      --service worldmaster \
      --domain $CUSTOM_DOMAIN \
      --region asia-northeast1
  fi

  # Clean up
  rm /tmp/gcp-key.json
else
  echo "GCP credentials not available. Skipping Cloud Run deployment."
  echo "To deploy manually, run: gcloud run deploy worldmaster --source . --platform managed --region asia-northeast1 --allow-unauthenticated"
fi

echo "Deployment completed successfully!"